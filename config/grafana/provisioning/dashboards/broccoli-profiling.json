{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "title": "HTTP Route Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "{{http_request_method}} {{http_route}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "HTTP Errors / Throughput",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (http_response_status_code) (rate(http_server_request_total[5m]))", "legendFormat": "{{http_response_status_code}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "rps" } }
    },
    {
      "title": "HTTP Body Size p95",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_body_size_bytes_bucket[5m])))", "legendFormat": "req {{http_request_method}} {{http_route}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_response_body_size_bytes_bucket[5m])))", "legendFormat": "resp {{http_request_method}} {{http_route}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "MQ Queue Depth / Message Age",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (queue_role, queue_name) (broccoli_mq_queue_depth)", "legendFormat": "depth {{queue_role}}/{{queue_name}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, queue, message_type) (rate(broccoli_mq_message_age_seconds_bucket[5m])))", "legendFormat": "age p95 {{queue}}/{{message_type}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "MQ Publish / Consume Latency p95",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, message_type, outcome) (rate(broccoli_mq_publish_duration_seconds_bucket[5m])))", "legendFormat": "pub {{message_type}}/{{outcome}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, message_type, outcome) (rate(broccoli_mq_consume_duration_seconds_bucket[5m])))", "legendFormat": "consume {{message_type}}/{{outcome}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Worker Active / Queue Wait",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (worker_id) (broccoli_worker_active_tasks)", "legendFormat": "active {{worker_id}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, task_type, executor) (rate(broccoli_task_queue_wait_duration_seconds_bucket[5m])))", "legendFormat": "queue p95 {{task_type}}/{{executor}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Step / Sandbox p95",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, step_kind, outcome) (rate(broccoli_step_duration_seconds_bucket[5m])))", "legendFormat": "step {{step_kind}}/{{outcome}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, outcome, sandbox_status) (rate(broccoli_sandbox_wall_time_used_seconds_bucket[5m])))", "legendFormat": "sandbox {{outcome}}/{{sandbox_status}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Blob Store / File Materialization",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, storage_backend, operation, outcome) (rate(broccoli_blob_store_operation_duration_seconds_bucket[5m])))", "legendFormat": "blob {{storage_backend}}/{{operation}}/{{outcome}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, source_kind, outcome) (rate(broccoli_operation_file_materialization_duration_seconds_bucket[5m])))", "legendFormat": "materialize {{source_kind}}/{{outcome}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Plugin Pool / Calls",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, plugin_kind, outcome) (rate(broccoli_plugin_admission_wait_duration_seconds_bucket[5m])))", "legendFormat": "admission {{plugin_kind}}/{{outcome}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, plugin_id, plugin_function, outcome) (rate(broccoli_plugin_call_duration_seconds_bucket[5m])))", "legendFormat": "call {{plugin_id}}/{{plugin_function}}/{{outcome}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Postgres",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (state) (pg_stat_activity_count)", "legendFormat": "connections {{state}}", "refId": "A" },
        { "expr": "sum(rate(pg_stat_statements_calls_total[5m]))", "legendFormat": "pg_stat_statements calls/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Redis / Host / Containers",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(redis_commands_processed_total[5m]))", "legendFormat": "redis commands/s", "refId": "A" },
        { "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))", "legendFormat": "host cpu", "refId": "B" },
        { "expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]))", "legendFormat": "container cpu", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 21 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "expr": "{level=~\"ERROR|WARN|error|warn\"}", "refId": "A" }
      ],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["broccoli", "profiling"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "",
  "title": "Broccoli Contest Profiling",
  "uid": "broccoli-profiling",
  "version": 2,
  "weekStart": ""
}
