{
  "name": "broccoli",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "format": "pnpm prettier --write \"{.,packages/**,plugins/**}/*.{ts,tsx,css,scss,html,json,md}\"",
    "format:check": "pnpm prettier --check \"{.,packages/**,plugins/**}/*.{ts,tsx,css,scss,html,json,md}\"",
    "lint": "pnpm eslint .",
    "test": "node --experimental-strip-types --test $(find eslint-rules packages/web/src packages/web/plugins packages/web-sdk/src plugins -name '*.test.ts' -not -path '*/node_modules/*')",
    "typecheck": "pnpm -r typecheck",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,html,md}": [
      "prettier --write"
    ],
    "*.rs": [
      "rustfmt --edition 2024"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-dom": "^2.13.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-react-x": "^2.13.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.4.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "~3.6.2",
    "smol-toml": "^1.9.1",
    "typescript-eslint": "^8.72.2"
  },
  "volta": {
    "node": "24.14.0"
  }
}
