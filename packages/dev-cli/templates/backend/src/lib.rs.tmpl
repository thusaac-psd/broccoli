#[cfg(target_arch = "wasm32")]
use broccoli_server_sdk::prelude::*;
#[cfg(target_arch = "wasm32")]
use extism_pdk::{FnResult, plugin_fn};

/// Runs once when the server loads the plugin. Register what the plugin
/// provides here through `host.registry`, for example an evaluator for a
/// problem type:
///
/// ```ignore
/// host.registry.register_evaluator("my-type", "evaluate_test_case")?;
/// ```
///
/// The shipped plugins under `plugins/` in the Broccoli repository, such as
/// `batch-evaluator` and `cooldown`, are complete examples.
#[cfg(target_arch = "wasm32")]
#[plugin_fn]
pub fn init() -> FnResult<String> {
    let host = Host::new();
    host.log.info("{{plugin_name_pascal}} plugin initialized")?;
    Ok("ok".into())
}

/// The `GET /api/plugins/{{plugin_name}}/hello` route declared in plugin.toml.
#[cfg(target_arch = "wasm32")]
#[plugin_fn]
pub fn hello(input: String) -> FnResult<String> {
    run_api_handler(&input, |host, _req| {
        host.log.info("{{plugin_name_pascal}} said hello")?;
        Ok(PluginHttpResponse {
            status: 200,
            headers: None,
            body: Some(serde_json::json!({ "message": "Hello from {{plugin_name_pascal}}!" })),
        })
    })
}
