# A plugin crate is its own workspace root, so it builds the same inside
# another project's workspace (a Broccoli checkout) and on its own.
[workspace]

[package]
name = "{{plugin_name}}"
version = "0.1.0"
edition = "2024"

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
broccoli-server-sdk = { {{server_sdk_dep}}, features = ["guest"] }
extism-pdk = "1.0"
serde_json = "1.0"

[profile.release]
opt-level = "z"
lto = "fat"
codegen-units = 1
panic = "abort"
strip = "symbols"
