{
  "name": "@broccoli/web-sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./tailwind-preset": "./dist/tailwind-preset.js",
    "./plugin.css": "./dist/plugin.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --dts",
    "dev": "tsdown --watch ./src --dts --no-clean"
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/tailwind-preset.ts",
      "src/*/index.ts"
    ],
    "platform": "neutral",
    "copy": [
      "src/index.css",
      "src/plugin.css"
    ]
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.546.0",
    "openapi-fetch": "^0.16.0",
    "react": "^19.3.1",
    "react-day-picker": "^9.14.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
