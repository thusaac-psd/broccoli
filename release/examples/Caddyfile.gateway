:80 {
	encode zstd gzip

	reverse_proxy {$BROCCOLI_UPSTREAMS} {
		lb_policy round_robin
		# /livez checks only that the server process answers; /healthz also
		# pings Postgres and Redis, so probing it would eject every server at
		# once whenever the shared infra blips. Two misses eject an upstream.
		health_uri /livez
		health_interval 5s
		health_timeout 2s
		health_fails 2
		health_passes 1
		# A request whose upstream cannot be reached is retried on another
		# upstream for up to 5s instead of failing with a 502.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
