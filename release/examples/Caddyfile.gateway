:80 {
	encode zstd gzip
	# Internal endpoints never reach the public edge: Prometheus scrapes
	# /metrics from each server on the internal network, and the API
	# documentation is for the operators, who reach a server directly.
	@internal path /metrics /metrics/* /swagger-ui /swagger-ui/* /scalar /scalar/* /api-docs /api-docs/*
	respond @internal 404

	reverse_proxy {$BROCCOLI_UPSTREAMS} {
		# Each browser sticks to one server (the broccoli_upstream cookie), so
		# during a rolling upgrade it loads the page and its chunks from one
		# build. A client without the cookie, or whose server is down, is sent
		# round robin and pinned to the server it reaches. The cookie has no
		# secret: its value is a hash of the server's address alone, so a
		# restarted gateway, or another gateway in front of the same servers,
		# keeps every browser on its server.
		lb_policy cookie broccoli_upstream {
			fallback round_robin
		}
		# /livez checks only that the server process answers; /healthz also
		# pings Postgres and Redis, so probing it would eject every server at
		# once whenever the shared infra blips. Two misses eject an upstream.
		health_uri /livez
		health_interval 5s
		health_timeout 2s
		health_fails 2
		health_passes 1
		# A request whose upstream cannot be reached is retried on another
		# upstream for up to 5s instead of failing with a 502.
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}
