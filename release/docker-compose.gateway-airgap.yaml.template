# Air-gap TLS gateway: terminates HTTPS on 443 with the internal-CA leaf and
# reverse-proxies to the broccoli servers in BROCCOLI_UPSTREAMS. The Caddyfile
# is mounted UN-rendered; Caddy expands {$LAN_HOST}/{$TLS_CERT}/{$TLS_KEY}/
# {$BROCCOLI_UPSTREAMS} from THIS container's environment at load time. Never
# envsubst it — that corrupts Caddy's {$VAR} syntax. Image comes from the
# bundle via `docker load`; `install.sh` composes this with `--pull never`.
#
# Self-contained: on the server host install.sh composes it together with
# docker-compose.server-airgap.yaml.template, and `install.sh --role gateway`
# runs it alone on a gateway-only host with .env.gateway, BROCCOLI_UPSTREAMS
# listing the servers' LAN addresses.
services:
  gateway:
    image: ${CADDY_IMAGE:-caddy:2-alpine}
    restart: unless-stopped
    ports:
      - "${BROCCOLI_GATEWAY_HTTPS_BIND:-0.0.0.0:443}:443"
    environment:
      LAN_HOST: "${LAN_HOST}"
      # Further names and addresses the leaf covers, space-separated.
      LAN_HOST_ALIASES: "${LAN_HOST_ALIASES:-}"
      TLS_CERT: /etc/broccoli-tls/server.crt
      TLS_KEY: /etc/broccoli-tls/server.key
      BROCCOLI_UPSTREAMS: "${BROCCOLI_UPSTREAMS:-server:3000}"
    command: ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
    volumes:
      - ../caddy/Caddyfile.airgap:/etc/caddy/Caddyfile:ro
      # Mount ONLY the leaf cert+key as individual files. The CA signing key
      # (root.key) shares the server-secret dir; binding the whole dir would
      # expose it inside this contestant-facing container. Caddy reads exactly
      # these two paths (TLS_CERT/TLS_KEY above).
      - "${BROCCOLI_TLS_CERT:?BROCCOLI_TLS_CERT must point at the server TLS leaf cert}:/etc/broccoli-tls/server.crt:ro"
      - "${BROCCOLI_TLS_KEY:?BROCCOLI_TLS_KEY must point at the server TLS leaf key}:/etc/broccoli-tls/server.key:ro"
      - caddy_data:/data
      - caddy_config:/config
    # Only on the edge network, at a fixed address outside the range Docker
    # hands out, so a server on this host trusts exactly that one address
    # for X-Forwarded-For (not the subnet, which also holds the bridge).
    networks:
      edge:
        ipv4_address: "${BROCCOLI_GATEWAY_EDGE_IP:-172.31.250.2}"

networks:
  # Keep in step with docker-compose.server-airgap.yaml.template.
  edge:
    ipam:
      config:
        - subnet: "${BROCCOLI_EDGE_SUBNET:-172.31.250.0/28}"
          ip_range: "${BROCCOLI_EDGE_RANGE:-172.31.250.8/29}"

volumes:
  caddy_data:
  caddy_config:
