[Unit]
Description=Broccoli SeaweedFS (S3)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

# Master (:9333), volume (:8080), filer (:8888, which lists and serves every
# blob without credentials), their gRPC ports, and S3 itself all listen on
# loopback only. The LAN reaches nothing but the credentialed S3 API, through
# broccoli-weed-s3.socket on @WEED_IP@:8333, the same exposure the Docker
# infra template has.

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@DATA_DIR@
ExecStart=/usr/local/bin/weed server -dir=@SEAWEED_DATA@ -ip=127.0.0.1 -ip.bind=127.0.0.1 -s3 -s3.config=@DATA_DIR@/config/seaweedfs-s3.json -s3.port=8334 -s3.port.iceberg=0
Restart=always
RestartSec=2
LimitNOFILE=1048576
StandardOutput=append:@DATA_DIR@/logs/weed.log
StandardError=append:@DATA_DIR@/logs/weed.log

[Install]
WantedBy=multi-user.target
