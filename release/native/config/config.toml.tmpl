[server]
id = "@SERVER_ID@"
host = "@HTTP_HOST@"
port = @HTTP_PORT@
frontend_dist = "@DATA_DIR@/packages/web/build/client"

[server.cors]
allow_origins = ["http://@INFRA_HOST@", "http://@INFRA_HOST@:3000"]

[worker]
id = "@WORKER_ID@"
sandbox_backend = "isolate"
isolate_bin = "isolate"
enable_cgroups = true

[worker.tools]
dir = "@DATA_DIR@/tools"

[database]
url = "@DB_URL@"

[mq]
enabled = true
url = "@MQ_URL@"

[auth]
jwt_secret = "@JWT_SECRET@"

[bootstrap]
admin_username = "admin"
admin_password = "@ADMIN_PASSWORD@"

[storage]
backend = "object_storage"
data_dir = "@DATA_DIR@-data"

[storage.object_storage]
bucket = "broccoli-blobs"
endpoint = "@S3_ENDPOINT@"
access_key = "@S3_ACCESS_KEY@"
secret_key = "@S3_SECRET_KEY@"
path_style = true

[plugin]
plugins_dir = "@DATA_DIR@/plugins"
enable_wasi = true
