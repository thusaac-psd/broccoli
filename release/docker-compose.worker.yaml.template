services:
  worker:
    image: ${BROCCOLI_WORKER_IMAGE}
    restart: unless-stopped
    privileged: true
    environment:
      BROCCOLI__WORKER__ID: "${BROCCOLI__WORKER__ID}"
      BROCCOLI__WORKER__SANDBOX_BACKEND: isolate
      BROCCOLI__WORKER__ISOLATE_BIN: /usr/local/bin/isolate
      BROCCOLI__WORKER__ENABLE_CGROUPS: "true"
      BROCCOLI__WORKER__MAX_CONCURRENCY: "${BROCCOLI__WORKER__MAX_CONCURRENCY:-1}"
      BROCCOLI__WORKER__DEDUP_TTL_SECS: "${BROCCOLI__WORKER__DEDUP_TTL_SECS:-600}"
      BROCCOLI__WORKER__FAIRNESS_UNSAFE_ALLOW: "${BROCCOLI__WORKER__FAIRNESS_UNSAFE_ALLOW:-false}"
      # Shared by every worker container on this host (including
      # `--scale worker=N` replicas) so each claims a distinct isolate box-id
      # slot. See `box_slot_lock_dir` in packages/worker/src/config.rs.
      BROCCOLI__WORKER__BOX_SLOT_LOCK_DIR: /var/lib/broccoli/box-slots
      BROCCOLI__DATABASE__URL: "${BROCCOLI__DATABASE__URL}"
      BROCCOLI__DATABASE__MAX_CONNECTIONS: "${BROCCOLI__WORKER_DATABASE_MAX_CONNECTIONS:-5}"
      BROCCOLI__MQ__ENABLED: "true"
      BROCCOLI__MQ__URL: "${BROCCOLI__MQ__URL}"
      BROCCOLI__STORAGE__BACKEND: "${BROCCOLI__STORAGE__BACKEND:-object_storage}"
      BROCCOLI__STORAGE__DATA_DIR: /data
      BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET: "${BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET:-broccoli-blobs}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__REGION: "${BROCCOLI__STORAGE__OBJECT_STORAGE__REGION:-us-east-1}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT: "${BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY: "${BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY: "${BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE: "${BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE:-true}"
      BROCCOLI__OBSERVABILITY__LOG_FORMAT: "${BROCCOLI__OBSERVABILITY__LOG_FORMAT:-json}"
      BROCCOLI__OBSERVABILITY__LOG_FILTER: "${BROCCOLI__OBSERVABILITY__LOG_FILTER:-info}"
    volumes:
      - ./plugins:/plugins:ro
      # NOTE: do NOT bind-mount the host's /usr/local/etc/isolate here. isolate's
      # default config lives at that path as a single FILE (not a directory), and
      # the worker image already bakes a correct one. A host bind makes Docker
      # auto-create an empty DIRECTORY at the missing source and then mount it over
      # the image's config file — "mount ... not a directory" — so the container
      # cannot start on any host lacking a pre-existing file there. Per-submission
      # resource limits are passed via isolate CLI flags, not this static config,
      # so no deployment needs to override it.
      - worker_data:/data
      - worker_box_slots:/var/lib/broccoli/box-slots
    healthcheck:
      test: ["CMD", "gosu", "worker:worker", "/usr/local/bin/broccoli-worker", "--healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 20

volumes:
  worker_data:
  worker_box_slots:
