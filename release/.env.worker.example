# Required settings for a worker node: where the infra node is. ./install.sh
# worker writes this file; every other setting derives from the machine or has
# a default. Advanced overrides are listed in docs/configuration-reference.md.
BROCCOLI_ROLE=worker
# Each role is its own Compose project, so roles on one host get separate
# networks. Keep this unchanged once the role is running: its volumes are
# named after it.
COMPOSE_PROJECT_NAME=broccoli-worker
# Worker image variants:
# - v0.3.0-icpc: C, C++, Java, Python; recommended for normal contests.
# - v0.3.0-full: ICPC plus Node.js, Go, Rust, Pascal, Kotlin.
# - v0.3.0-base: isolate sandbox only; intended for custom derived images.
BROCCOLI_WORKER_IMAGE=ghcr.io/thusaac-psd/broccoli/broccoli-worker:v0.3.0-icpc
BROCCOLI__WORKER__ID=worker-1

BROCCOLI__DATABASE__URL=postgres://postgres:change-me-postgres@change-me-infra-host:5432/broccoli
BROCCOLI__MQ__URL=redis://:change-me-redis@change-me-infra-host:6379

BROCCOLI__STORAGE__BACKEND=object_storage
BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET=broccoli-blobs
BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT=http://change-me-infra-host:8333
BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY=change-me-s3-access
BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY=change-me-s3-secret
BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE=true
