BROCCOLI_ROLE=server
BROCCOLI_SERVER_IMAGE=ghcr.io/thusaac-psd/broccoli/broccoli-server:v0.3.0
# NOTE: the airgap installer (release/airgap/install.sh) exports
# BROCCOLI_HTTP_BIND=127.0.0.1:3000, overriding this line so only the 443 TLS
# gateway is LAN-reachable. This 0.0.0.0 value applies to non-airgap deploys.
BROCCOLI_HTTP_BIND=0.0.0.0:3000
BROCCOLI__SERVER__ID=server-1
BROCCOLI__SERVER__EXPECTS_MULTI_REPLICA=true
# Enable lease/steal recovery: lease refresh, steal scanning, and reply-queue
# sweeping. Default is false until UP#15-18 has shaken out in your production
# fleet; flip to true once you have lease/steal soak data you trust.
BROCCOLI__SERVER__DISPATCHER_LEASE_STEAL_ENABLED=false
BROCCOLI__SERVER__DISPATCHER_SEMAPHORE_ENABLED=true
BROCCOLI__SERVER__DISPATCHER_CONCURRENCY=16
BROCCOLI__SERVER__MAX_QUEUED_SUBMISSIONS=100
BROCCOLI__SERVER__CANCEL_PRIMITIVE_ENABLED=false
BROCCOLI__SERVER__LEASE_TTL_SECS=60
BROCCOLI__SERVER__LEASE_REFRESH_INTERVAL_SECS=10
BROCCOLI__SERVER__STEAL_SCAN_INTERVAL_SECS=15
BROCCOLI__SERVER__STEAL_BATCH_SIZE=8
BROCCOLI__SERVER__SWEEP_INTERVAL_SECS=300
BROCCOLI__SERVER__MAX_DISPATCH_RETRIES=5
# Default is now false (sweeper actively DELs ghost reply queues). Set to
# true to audit what the sweeper would delete without touching Redis.
BROCCOLI__SERVER__SWEEPER_DRY_RUN=false
BROCCOLI__SERVER__FLEET_AWARE_ADMISSION_ENABLED=false
BROCCOLI__SERVER__FLEET_CAPACITY_POLL_INTERVAL_SECS=5
# Override only on memory-constrained hosts (each blocking thread reserves
# ~2MB stack) or when plugin.evaluator_parallelism is dialed well above CPU
# count. Default auto-scales to available_parallelism * 16, clamped [512, 8192].
#BROCCOLI__SERVER__MAX_BLOCKING_THREADS=1024
BROCCOLI__SERVER__TRUSTED_PROXIES=[]
BROCCOLI__SERVER__RATE_LIMIT_AUTH=true
BROCCOLI__SERVER_DATABASE_MAX_CONNECTIONS=50

BROCCOLI__DATABASE__URL=postgres://postgres:change-me-postgres@change-me-infra-host:5432/broccoli
BROCCOLI__MQ__URL=redis://:change-me-redis@change-me-infra-host:6379
BROCCOLI__AUTH__JWT_SECRET=change-me-jwt-secret-at-least-32-chars
BROCCOLI__AUTH__SECURE_COOKIES=false
BROCCOLI_BOOTSTRAP_ADMIN_USERNAME=admin
BROCCOLI_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BROCCOLI__SUBMISSION__RATE_LIMIT_PER_MINUTE=10000

BROCCOLI__PLUGIN__POOL_MAX_INSTANCES=64
BROCCOLI__PLUGIN__EVALUATOR_PARALLELISM=64

BROCCOLI__STORAGE__BACKEND=object_storage
BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET=broccoli-blobs
BROCCOLI__STORAGE__OBJECT_STORAGE__REGION=us-east-1
BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT=http://change-me-infra-host:8333
BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY=change-me-s3-access
BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY=change-me-s3-secret
BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE=true

BROCCOLI__OBSERVABILITY__LOG_FORMAT=json
BROCCOLI__OBSERVABILITY__LOG_FILTER=info
