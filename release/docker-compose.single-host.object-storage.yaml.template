services:
  db:
    extends:
      file: docker-compose.infra.yaml.template
      service: db

  redis:
    extends:
      file: docker-compose.infra.yaml.template
      service: redis

  seaweedfs:
    extends:
      file: docker-compose.infra.yaml.template
      service: seaweedfs

  seaweedfs-init:
    extends:
      file: docker-compose.infra.yaml.template
      service: seaweedfs-init
    depends_on:
      seaweedfs:
        condition: service_healthy

  server:
    extends:
      file: docker-compose.server.yaml.template
      service: server
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      seaweedfs:
        condition: service_healthy
      seaweedfs-init:
        condition: service_completed_successfully
    environment:
      BROCCOLI__DATABASE__URL: "${BROCCOLI_LOCAL_DATABASE_URL:?install.sh single-host writes the in-container database URL}"
      # Unset unless the env file sets them, so the binary's defaults apply.
      # BROCCOLI__CLOCK__MAX_SKEW_MS=0 lets a node with a skewed clock boot.
      BROCCOLI__DATABASE__STATEMENT_TIMEOUT_SECS:
      BROCCOLI__DATABASE__TCP_KEEPALIVES:
      BROCCOLI__DATABASE__ALLOW_MISSING_UNIQUE_INDEXES:
      BROCCOLI__CLOCK__WARN_SKEW_MS:
      BROCCOLI__CLOCK__MAX_SKEW_MS:
      BROCCOLI__MQ__URL: "${BROCCOLI_LOCAL_MQ_URL:?install.sh single-host writes the in-container MQ URL}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT: http://seaweedfs:8333

  worker:
    extends:
      file: docker-compose.worker.yaml.template
      service: worker
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      seaweedfs:
        condition: service_healthy
      seaweedfs-init:
        condition: service_completed_successfully
    environment:
      BROCCOLI__DATABASE__URL: "${BROCCOLI_LOCAL_DATABASE_URL:?install.sh single-host writes the in-container database URL}"
      # Unset unless the env file sets them, so the binary's defaults apply.
      # BROCCOLI__CLOCK__MAX_SKEW_MS=0 lets a node with a skewed clock boot.
      BROCCOLI__DATABASE__STATEMENT_TIMEOUT_SECS:
      BROCCOLI__DATABASE__TCP_KEEPALIVES:
      BROCCOLI__CLOCK__WARN_SKEW_MS:
      BROCCOLI__CLOCK__MAX_SKEW_MS:
      BROCCOLI__MQ__URL: "${BROCCOLI_LOCAL_MQ_URL:?install.sh single-host writes the in-container MQ URL}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT: http://seaweedfs:8333

volumes:
  postgres_data:
  redis_data:
  seaweed_data:
  server_data:
  worker_data:
  worker_box_slots:
