services:
  db:
    extends:
      file: docker-compose.infra.yaml.template
      service: db

  redis:
    extends:
      file: docker-compose.infra.yaml.template
      service: redis

  seaweedfs:
    extends:
      file: docker-compose.infra.yaml.template
      service: seaweedfs

  seaweedfs-init:
    extends:
      file: docker-compose.infra.yaml.template
      service: seaweedfs-init
    depends_on:
      seaweedfs:
        condition: service_healthy

  server:
    extends:
      file: docker-compose.server.yaml.template
      service: server
    # The single-host env file holds every secret of the host, so each
    # container reads only its own overrides.
    env_file: !override
      - path: .env.single-host.server
        required: false
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      seaweedfs:
        condition: service_healthy
      seaweedfs-init:
        condition: service_completed_successfully
    environment:
      BROCCOLI__DATABASE__URL: "${BROCCOLI_LOCAL_DATABASE_URL:?install.sh single-host writes the in-container database URL}"
      BROCCOLI__MQ__URL: "${BROCCOLI_LOCAL_MQ_URL:?install.sh single-host writes the in-container MQ URL}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT: http://seaweedfs:8333

  worker:
    extends:
      file: docker-compose.worker.yaml.template
      service: worker
    # The single-host env file holds every secret of the host, so each
    # container reads only its own overrides.
    env_file: !override
      - path: .env.single-host.worker
        required: false
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
      seaweedfs:
        condition: service_healthy
      seaweedfs-init:
        condition: service_completed_successfully
    environment:
      BROCCOLI__DATABASE__URL: "${BROCCOLI_LOCAL_DATABASE_URL:?install.sh single-host writes the in-container database URL}"
      BROCCOLI__MQ__URL: "${BROCCOLI_LOCAL_MQ_URL:?install.sh single-host writes the in-container MQ URL}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT: http://seaweedfs:8333

volumes:
  postgres_data:
  redis_data:
  seaweed_data:
  server_data:
  plugin_cache:
  worker_data:
  worker_box_slots:
