services:
  db:
    image: ${POSTGRES_IMAGE:-postgres:18-alpine}
    restart: unless-stopped
    ports:
      - "${POSTGRES_BIND:-0.0.0.0:5432}:5432"
    environment:
      # The superuser initializes the database; the servers and workers log in
      # as BROCCOLI_DB_USER, which owns it and holds CREATEROLE and nothing
      # more (it provisions each plugin's own role).
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
      BROCCOLI_DB_USER: ${BROCCOLI_DB_USER:-broccoli}
      BROCCOLI_DB_PASSWORD: ${BROCCOLI_DB_PASSWORD:?BROCCOLI_DB_PASSWORD is the app role's password}
    # On an empty volume the image runs /docker-entrypoint-initdb.d once, as
    # the superuser: create the app role there.
    entrypoint:
      - sh
      - -c
      - |
        mkdir -p /docker-entrypoint-initdb.d
        cat > /docker-entrypoint-initdb.d/20-broccoli-app-role.sh <<'INIT'
        psql -v ON_ERROR_STOP=1 -U "$$POSTGRES_USER" -d "$$POSTGRES_DB" \
          -v app="$$BROCCOLI_DB_USER" -v pw="$$BROCCOLI_DB_PASSWORD" -v db="$$POSTGRES_DB" <<'SQL'
        CREATE ROLE :"app" LOGIN CREATEROLE PASSWORD :'pw';
        ALTER DATABASE :"db" OWNER TO :"app";
        -- The statement statistics need the superuser to create the extension.
        CREATE EXTENSION IF NOT EXISTS pg_stat_statements;
        SQL
        INIT
        exec docker-entrypoint.sh "$$@"
      - sh
    # Sized for contest-scale fleets. A server holds at most 66 connections, a
    # worker 3, and each server fits its pools to its share at boot. 500 fits
    # 5 servers and 30 workers at their peak with a tenth kept for operators;
    # raise POSTGRES_MAX_CONNECTIONS for a larger fleet.
    command:
      - "postgres"
      - "-c"
      - "max_connections=${POSTGRES_MAX_CONNECTIONS:-500}"
      - "-c"
      - "shared_buffers=${POSTGRES_SHARED_BUFFERS:-512MB}"
      - "-c"
      - "effective_cache_size=${POSTGRES_EFFECTIVE_CACHE_SIZE:-2GB}"
      - "-c"
      - "work_mem=${POSTGRES_WORK_MEM:-8MB}"
      - "-c"
      - "maintenance_work_mem=${POSTGRES_MAINTENANCE_WORK_MEM:-128MB}"
      - "-c"
      - "random_page_cost=1.1"
      - "-c"
      - "log_lock_waits=on"
      - "-c"
      - "log_min_duration_statement=2000"
      - "-c"
      - "idle_in_transaction_session_timeout=60000"
    volumes:
      - postgres_data:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 5s
      timeout: 5s
      retries: 20

  redis:
    image: ${REDIS_IMAGE:-redis:7-alpine}
    restart: unless-stopped
    # Holds Broccoli's message queue streams and node liveness keys. Redis 7 or
    # newer: the queue uses stream commands added in 6.2 and 7.0.
    #
    # CRITICAL: maxmemory-policy MUST be noeviction. Every key Broccoli writes is
    # correctness-bearing - stream entries are queued or in-flight operations
    # and dead letters, and liveness keys decide which nodes are alive.
    # allkeys-lru would silently lose them. When Redis is full under
    # noeviction, publishes fail with OOM and the operation batch fails loudly
    # instead of losing its tasks.
    #
    # AOF with everysec bounds a crash to the last second of writes; the stuck
    # job detector recovers work lost in it.
    #
    # Sizing rationale (override via REDIS_MAXMEMORY):
    #   ~300 MB operation task entries pending under a 1000-submission spike
    #   replies are trimmed as each server reads them, so reply streams stay small
    #   ~30% AOF rewrite working memory headroom
    #   ~safety margin
    # Default 6 GB. Single-host: 2 GB. Large/national: 12 GB.
    command:
      - "redis-server"
      - "--requirepass"
      - "${REDIS_PASSWORD}"
      - "--appendonly"
      - "yes"
      - "--appendfsync"
      - "everysec"
      - "--maxmemory"
      - "${REDIS_MAXMEMORY:-6gb}"
      - "--maxmemory-policy"
      - "noeviction"
      - "--tcp-keepalive"
      - "60"
      - "--timeout"
      - "0"
      - "--save"
      - ""
    ports:
      - "${REDIS_BIND:-0.0.0.0:6379}:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "${REDIS_PASSWORD}", "ping"]
      interval: 5s
      timeout: 5s
      retries: 20

  seaweedfs:
    image: ${SEAWEEDFS_IMAGE:-chrislusf/seaweedfs:4.15}
    restart: unless-stopped
    entrypoint: ["sh", "-ec"]
    # The S3 keys reach the script below as container env, expanded by the
    # shell when it runs ($$S3_ACCESS_KEY). Compose never pastes them into the
    # script text, so no key can change what the script does. The installers
    # refuse keys with quotes or backslashes, so the JSON stays valid.
    environment:
      S3_ACCESS_KEY: "${BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY}"
      S3_SECRET_KEY: "${BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY}"
    # Tuned for testcase-blob workloads. Defaults assume 50 MB-class testcase
    # inputs/outputs and a single-volume node; raise -volume.max if you observe
    # frequent volume rotation in the master logs.
    #
    #   -volume.max=8                   # allow up to 8 concurrent volumes
    #   -master.volumeSizeLimitMB=2048  # rotate sooner under heavy small-write traffic
    #   -volume.compactionMBps=50       # cap compaction I/O so it can't starve reads
    command:
      - |
        cat > /tmp/seaweedfs-s3.json <<EOF
        {
          "identities": [
            {
              "name": "broccoli",
              "credentials": [
                {
                  "accessKey": "$$S3_ACCESS_KEY",
                  "secretKey": "$$S3_SECRET_KEY"
                }
              ],
              "actions": ["Admin", "Read", "Write", "List", "Tagging"]
            }
          ]
        }
        EOF
        exec weed server \
          -dir=/data \
          -s3 \
          -s3.config=/tmp/seaweedfs-s3.json \
          -ip=seaweedfs \
          -volume.max=${SEAWEEDFS_VOLUME_MAX:-8} \
          -master.volumeSizeLimitMB=${SEAWEEDFS_VOLUME_SIZE_LIMIT_MB:-2048} \
          -volume.compactionMBps=${SEAWEEDFS_COMPACTION_MBPS:-50}
    ports:
      - "${SEAWEEDFS_MASTER_BIND:-127.0.0.1:9333}:9333"
      - "${SEAWEEDFS_S3_BIND:-0.0.0.0:8333}:8333"
    volumes:
      - seaweed_data:/data
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:9333/"]
      interval: 5s
      timeout: 5s
      retries: 20

  # Creates the blob bucket, then proves it exists. The master's health check
  # says nothing about the filer this talks to, and `weed shell` exits 0 even
  # when a command inside it fails, so the job waits for the filer itself and
  # succeeds only once `s3.bucket.list` shows the bucket. Any other outcome
  # exits nonzero, which the installers and `depends_on` report as a failure.
  seaweedfs-init:
    image: ${SEAWEEDFS_IMAGE:-chrislusf/seaweedfs:4.15}
    depends_on:
      seaweedfs:
        condition: service_healthy
    environment:
      BUCKET: "${BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET:-broccoli-blobs}"
    entrypoint: ["sh", "-c"]
    command:
      - |
        weed_shell() { weed shell -master=seaweedfs:9333 -filer=seaweedfs:8888; }
        tries=0
        until wget -q -O /dev/null http://seaweedfs:8888/; do
          tries=$$((tries + 1))
          if [ "$$tries" -ge 60 ]; then
            echo "seaweedfs-init: the filer at seaweedfs:8888 did not answer within 120s" >&2
            exit 1
          fi
          sleep 2
        done
        tries=0
        while :; do
          printf 's3.bucket.create -name %s\n' "$$BUCKET" | weed_shell >/tmp/create.log 2>&1
          if printf 's3.bucket.list\n' | weed_shell 2>/dev/null \
            | awk -v b="$$BUCKET" '{ for (i = 1; i <= NF; i++) if ($$i == b) found = 1 } END { exit !found }'; then
            echo "seaweedfs-init: bucket $$BUCKET is ready"
            exit 0
          fi
          tries=$$((tries + 1))
          if [ "$$tries" -ge 10 ]; then
            cat /tmp/create.log >&2
            echo "seaweedfs-init: bucket $$BUCKET is missing after s3.bucket.create" >&2
            exit 1
          fi
          sleep 3
        done
    restart: "no"

volumes:
  postgres_data:
  redis_data:
  seaweed_data:
