# Common image tags. The offline installer rewrites these when it loads images
# from the bundle; registry-based installs can set pinned GHCR/ACR tags.
BROCCOLI_VERSION=v0.3.0
BROCCOLI_SERVER_IMAGE=ghcr.io/thusaac-psd/broccoli/broccoli-server:v0.3.0
# Worker image variants are -icpc, -full, and -base. The interactive
# installer explains the tradeoff and defaults to -icpc.
BROCCOLI_WORKER_IMAGE=ghcr.io/thusaac-psd/broccoli/broccoli-worker:v0.3.0-icpc
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:7-alpine
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:4.15
CADDY_IMAGE=caddy:2-alpine

# Shared infra connection strings. Generate these on the infra node, then copy
# the resulting values to server and worker nodes.
BROCCOLI__DATABASE__URL=postgres://broccoli:change-me-db-app@change-me-infra-host:5432/broccoli
BROCCOLI__MQ__URL=redis://:change-me-redis@change-me-infra-host:6379

# Shared blob storage. object_storage (SeaweedFS) is the recommended default - it
# keeps testcase blob traffic off the Postgres connection pool, which would otherwise
# saturate at contest scale. Switch to "database" only for tiny demos with no S3
# available; the contest-grade infra template already deploys SeaweedFS.
BROCCOLI__STORAGE__BACKEND=object_storage
BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET=broccoli-blobs
BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT=http://change-me-infra-host:8333
BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY=change-me-s3-access
BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY=change-me-s3-secret
BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE=true

# Server secrets shared by all server replicas.
# false: refuse admin plugin uploads and run only the bundled plugins.
BROCCOLI__PLUGIN__UPLOADS_ENABLED=true
BROCCOLI__AUTH__JWT_SECRET=change-me-jwt-secret-at-least-32-chars
BROCCOLI_BOOTSTRAP_ADMIN_USERNAME=admin
BROCCOLI_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Per-node identities. Override these per server or worker machine.
BROCCOLI__SERVER__ID=server-1
BROCCOLI__WORKER__ID=worker-1

# Role-specific binds.
POSTGRES_BIND=0.0.0.0:5432
REDIS_BIND=0.0.0.0:6379
SEAWEEDFS_S3_BIND=0.0.0.0:8333
SEAWEEDFS_MASTER_BIND=127.0.0.1:9333
BROCCOLI_HTTP_BIND=0.0.0.0:3000
BROCCOLI_GATEWAY_HTTP_BIND=0.0.0.0:80
BROCCOLI_UPSTREAMS='10.0.0.21:3000 10.0.0.22:3000'
# The gateway's address, and only that, when a gateway fronts this server
# (docs/tls-with-caddy.md); [] without one. install.sh server writes it from
# BROCCOLI_GATEWAY_HOSTS.
BROCCOLI__SERVER__TRUSTED_PROXIES='["10.0.0.5/32"]'

# The superuser initializes the database; servers and workers log in as
# BROCCOLI_DB_USER, which owns it and holds CREATEROLE and nothing more.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=broccoli
BROCCOLI_DB_USER=broccoli
BROCCOLI_DB_PASSWORD=change-me-db-app
REDIS_PASSWORD=change-me-redis
# Single-host only: the URLs its containers use to reach db and redis, with the
# passwords above percent-encoded. install.sh single-host writes them.
BROCCOLI_LOCAL_DATABASE_URL=postgres://broccoli:change-me-db-app@db:5432/broccoli
BROCCOLI_LOCAL_MQ_URL=redis://:change-me-redis@redis:6379

# Every other setting derives from the machine or has a default; see
# docs/configuration-reference.md.
