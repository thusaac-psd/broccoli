services:
  server:
    image: ${BROCCOLI_SERVER_IMAGE}
    restart: unless-stopped
    ports:
      - "${BROCCOLI_HTTP_BIND:-0.0.0.0:3000}:3000"
    environment:
      BROCCOLI__SERVER__HOST: 0.0.0.0
      BROCCOLI__SERVER__PORT: 3000
      BROCCOLI__SERVER__ID: "${BROCCOLI__SERVER__ID}"
      BROCCOLI__SERVER__EXPECTS_MULTI_REPLICA: "${BROCCOLI__SERVER__EXPECTS_MULTI_REPLICA:-true}"
      BROCCOLI__SERVER__DISPATCHER_LEASE_STEAL_ENABLED: "${BROCCOLI__SERVER__DISPATCHER_LEASE_STEAL_ENABLED:-false}"
      BROCCOLI__SERVER__DISPATCHER_SEMAPHORE_ENABLED: "${BROCCOLI__SERVER__DISPATCHER_SEMAPHORE_ENABLED:-true}"
      BROCCOLI__SERVER__DISPATCHER_CONCURRENCY: "${BROCCOLI__SERVER__DISPATCHER_CONCURRENCY:-16}"
      BROCCOLI__SERVER__MAX_QUEUED_SUBMISSIONS: "${BROCCOLI__SERVER__MAX_QUEUED_SUBMISSIONS:-100}"
      BROCCOLI__SERVER__CANCEL_PRIMITIVE_ENABLED: "${BROCCOLI__SERVER__CANCEL_PRIMITIVE_ENABLED:-false}"
      BROCCOLI__SERVER__LEASE_TTL_SECS: "${BROCCOLI__SERVER__LEASE_TTL_SECS:-60}"
      BROCCOLI__SERVER__LEASE_REFRESH_INTERVAL_SECS: "${BROCCOLI__SERVER__LEASE_REFRESH_INTERVAL_SECS:-10}"
      BROCCOLI__SERVER__STEAL_SCAN_INTERVAL_SECS: "${BROCCOLI__SERVER__STEAL_SCAN_INTERVAL_SECS:-15}"
      BROCCOLI__SERVER__STEAL_BATCH_SIZE: "${BROCCOLI__SERVER__STEAL_BATCH_SIZE:-8}"
      BROCCOLI__SERVER__SWEEP_INTERVAL_SECS: "${BROCCOLI__SERVER__SWEEP_INTERVAL_SECS:-300}"
      BROCCOLI__SERVER__MAX_DISPATCH_RETRIES: "${BROCCOLI__SERVER__MAX_DISPATCH_RETRIES:-5}"
      BROCCOLI__SERVER__SWEEPER_DRY_RUN: "${BROCCOLI__SERVER__SWEEPER_DRY_RUN:-false}"
      # Unset unless the env file sets it: the server then sizes tokio's
      # blocking pool itself (see server.max_blocking_threads).
      BROCCOLI__SERVER__MAX_BLOCKING_THREADS:
      BROCCOLI__SERVER__FRONTEND_DIST: /srv/dist
      BROCCOLI__SERVER__TRUSTED_PROXIES: "${BROCCOLI__SERVER__TRUSTED_PROXIES:-[]}"
      BROCCOLI__SERVER__RATE_LIMIT_AUTH: "${BROCCOLI__SERVER__RATE_LIMIT_AUTH:-true}"
      BROCCOLI__DATABASE__URL: "${BROCCOLI__DATABASE__URL}"
      # Unset unless the env file sets them, so the binary's defaults apply.
      # BROCCOLI__CLOCK__MAX_SKEW_MS=0 lets a node with a skewed clock boot.
      BROCCOLI__DATABASE__STATEMENT_TIMEOUT_SECS:
      BROCCOLI__DATABASE__TCP_KEEPALIVES:
      BROCCOLI__DATABASE__ALLOW_MISSING_UNIQUE_INDEXES:
      BROCCOLI__CLOCK__WARN_SKEW_MS:
      BROCCOLI__CLOCK__MAX_SKEW_MS:
      BROCCOLI__DATABASE__MAX_CONNECTIONS: "${BROCCOLI__SERVER_DATABASE_MAX_CONNECTIONS:-40}"
      BROCCOLI__MQ__ENABLED: "true"
      BROCCOLI__MQ__URL: "${BROCCOLI__MQ__URL}"
      BROCCOLI__AUTH__JWT_SECRET: "${BROCCOLI__AUTH__JWT_SECRET}"
      BROCCOLI__AUTH__SECURE_COOKIES: "${BROCCOLI__AUTH__SECURE_COOKIES:-false}"
      BROCCOLI__PLUGIN__PLUGINS_DIR: /plugins
      # Per-replica plugin capacity; docs/operator-runbook.md explains both.
      BROCCOLI__PLUGIN__POOL_MAX_INSTANCES: "${BROCCOLI__PLUGIN__POOL_MAX_INSTANCES:-64}"
      BROCCOLI__PLUGIN__EVALUATOR_PARALLELISM: "${BROCCOLI__PLUGIN__EVALUATOR_PARALLELISM:-64}"
      BROCCOLI__STORAGE__BACKEND: "${BROCCOLI__STORAGE__BACKEND:-object_storage}"
      BROCCOLI__STORAGE__DATA_DIR: /data
      BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET: "${BROCCOLI__STORAGE__OBJECT_STORAGE__BUCKET:-broccoli-blobs}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__REGION: "${BROCCOLI__STORAGE__OBJECT_STORAGE__REGION:-us-east-1}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT: "${BROCCOLI__STORAGE__OBJECT_STORAGE__ENDPOINT}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY: "${BROCCOLI__STORAGE__OBJECT_STORAGE__ACCESS_KEY}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY: "${BROCCOLI__STORAGE__OBJECT_STORAGE__SECRET_KEY}"
      BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE: "${BROCCOLI__STORAGE__OBJECT_STORAGE__PATH_STYLE:-true}"
      BROCCOLI__SUBMISSION__RATE_LIMIT_PER_MINUTE: "${BROCCOLI__SUBMISSION__RATE_LIMIT_PER_MINUTE:-10000}"
      BROCCOLI__BOOTSTRAP__ADMIN_USERNAME: "${BROCCOLI_BOOTSTRAP_ADMIN_USERNAME:-admin}"
      BROCCOLI__BOOTSTRAP__ADMIN_PASSWORD: "${BROCCOLI_BOOTSTRAP_ADMIN_PASSWORD}"
      BROCCOLI__OBSERVABILITY__LOG_FORMAT: "${BROCCOLI__OBSERVABILITY__LOG_FORMAT:-json}"
      BROCCOLI__OBSERVABILITY__LOG_FILTER: "${BROCCOLI__OBSERVABILITY__LOG_FILTER:-info}"
    volumes:
      # Read-only on purpose: plugins ship in the bundle to every node, and
      # admin plugin upload is unsupported here (see README.md).
      - ./plugins:/plugins:ro
      - server_data:/data
    healthcheck:
      test: ["CMD", "/usr/local/bin/broccoli-server", "--healthcheck"]
      interval: 10s
      timeout: 5s
      retries: 20

volumes:
  server_data:
