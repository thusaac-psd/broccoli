{
  "name": "@broccoli/plugin-standard-languages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --dts",
    "dev": "tsdown --watch --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "tsdown": {
    "entry": [
      "src/index.tsx"
    ],
    "platform": "neutral",
    "deps": {
      "neverBundle": [
        "react",
        "react-dom",
        "@broccoli/web-sdk/api",
        "@broccoli/web-sdk/i18n",
        "@broccoli/web-sdk/slot",
        "@broccoli/web-sdk/ui",
        "@broccoli/web-sdk/utils"
      ]
    }
  },
  "dependencies": {
    "@broccoli/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
