{
  "name": "@broccoli/plugin-submission-limit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --dts",
    "dev": "tsdown --watch --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "tsdown": {
    "entry": [
      "src/index.tsx",
      "src/styles.css"
    ],
    "platform": "neutral",
    "css": {
      "transformer": "postcss",
      "fileName": "styles.css"
    },
    "deps": {
      "neverBundle": [
        "react",
        "@broccoli/web-sdk/api",
        "@broccoli/web-sdk/i18n",
        "@broccoli/web-sdk/ui",
        "@broccoli/web-sdk/utils"
      ]
    }
  },
  "dependencies": {
    "@broccoli/web-sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/react": "catalog:",
    "postcss": "catalog:",
    "postcss-import": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
